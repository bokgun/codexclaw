{
  "name": "codexclaw",
  "version": "0.0.0",
  "private": true,
  "description": "Minimal Codex app-server client host inspired by nanoclaw.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "schema:generate": "codex app-server generate-ts --out schemas/generated",
    "schema:verify": "bash scripts/verify-schema-gate.sh",
    "cli": "bun src/runtime/cli.ts",
    "spike:repl": "bun src/spike/cli-repl.ts",
    "spike:turn": "bun src/spike/turn-probe.ts",
    "spike:diff-tool": "bun src/spike/diff-tool-probe.ts",
    "spike:approval": "bun src/spike/approval-demo.ts",
    "spike:cancel": "bun src/spike/cancel-probe.ts",
    "spike:reconnect": "bun src/spike/reconnect-probe.ts",
    "spike:pointer-store": "bun src/spike/pointer-store-probe.ts",
    "start:codex": "bash scripts/start-codex-app-server.sh"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.0"
  },
  "codexclaw": {
    "codexCliVersion": "0.128.0",
    "appServerSchema": {
      "activeDirectory": "schemas/generated",
      "generateCommand": "codex app-server generate-ts --out schemas/generated",
      "experimental": false,
      "provenance": "docs/schema-provenance.md"
    }
  }
}
