# Codex app-server WebSocket endpoint. Loopback ws:// is allowed; use wss:// for non-loopback.
CODEXCLAW_CODEX_WS=ws://127.0.0.1:4500

# Project directory where Codex should run. Created if it does not exist.
# Defaults to the directory where you start codexclaw.
CODEXCLAW_WORKSPACE_ROOT=

# Directory for codexclaw-owned state such as tokens and SQLite. Created with private permissions.
# Defaults to <workspace>/.codexclaw. Use ~/.codexclaw/... to keep state outside the workspace.
CODEXCLAW_STATE_DIR=

# Local token file used by codexclaw when connecting to codex app-server. Relative paths resolve from the state dir.
CODEXCLAW_CODEX_TOKEN_FILE=

# SQLite database path for codexclaw pointers, approvals, tasks, and prefs. Relative paths resolve from the state dir.
CODEXCLAW_DB=

# Legacy mention trigger placeholder for older channel experiments.
CODEXCLAW_TRIGGER=@codex

# Telegram bot token from BotFather. Required for `bun run telegram`.
CODEXCLAW_TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to use this host.
CODEXCLAW_TELEGRAM_ALLOWED_USER_IDS=

# Local development escape hatch: allow Telegram users without an allowlist.
CODEXCLAW_TELEGRAM_ALLOW_ALL_USERS_FOR_LOCAL_DEV=false

# Telegram Bot API base URL. Override for tests or a self-hosted Bot API.
CODEXCLAW_TELEGRAM_API_BASE_URL=https://api.telegram.org

# Telegram long-poll timeout in seconds.
CODEXCLAW_TELEGRAM_POLLING_TIMEOUT_SECONDS=30

# Time window in milliseconds for collecting Telegram Modify replies.
CODEXCLAW_TELEGRAM_MODIFY_TIMEOUT_MS=600000

# Streaming delta coalescing window in milliseconds for Telegram.
CODEXCLAW_TELEGRAM_DELTA_FLUSH_MS=10000

# Discord bot token. Required for `bun run discord`.
CODEXCLAW_DISCORD_BOT_TOKEN=

# Discord application ID used for slash commands, interactions, and mention stripping.
CODEXCLAW_DISCORD_APPLICATION_ID=

# Discord interaction Ed25519 public key as 64 hex characters.
CODEXCLAW_DISCORD_PUBLIC_KEY=

# Comma-separated Discord user IDs allowed to use this host.
CODEXCLAW_DISCORD_ALLOWED_USER_IDS=

# Optional comma-separated Discord guild IDs. Empty means any guild for allowed users.
CODEXCLAW_DISCORD_ALLOWED_GUILD_IDS=

# Host for the signed Discord interaction HTTP receiver.
CODEXCLAW_DISCORD_INTERACTIONS_HOST=127.0.0.1

# Port for the signed Discord interaction HTTP receiver.
CODEXCLAW_DISCORD_INTERACTIONS_PORT=8787

# Path for the signed Discord interaction HTTP receiver.
CODEXCLAW_DISCORD_INTERACTIONS_PATH=/discord/interactions

# Optional Discord Gateway URL override. Must be wss://, or ws:// only for loopback tests.
CODEXCLAW_DISCORD_GATEWAY_URL=

# Discord REST API base URL. Override only for tests.
CODEXCLAW_DISCORD_API_BASE_URL=https://discord.com/api/v10

# Time window in milliseconds for approval Modify flows.
CODEXCLAW_DISCORD_MODIFY_TIMEOUT_MS=600000

# Streaming delta coalescing window in milliseconds for Discord.
CODEXCLAW_DISCORD_DELTA_FLUSH_MS=750

# Local development escape hatch: allow Discord users without an allowlist.
CODEXCLAW_DISCORD_ALLOW_ALL_USERS_FOR_LOCAL_DEV=false

# Enable scheduled task execution in the current runtime process.
CODEXCLAW_SCHEDULER_ENABLED=false

# Scheduler polling interval in milliseconds.
CODEXCLAW_SCHEDULER_TICK_MS=30000

# Default retry count for newly-created scheduled tasks.
CODEXCLAW_SCHEDULER_DEFAULT_RETRY=0

# Default timeout in seconds for newly-created scheduled tasks.
CODEXCLAW_SCHEDULER_DEFAULT_TIMEOUT_SEC=300

# Disable a task after this many consecutive failures.
CODEXCLAW_SCHEDULER_FAILURE_THRESHOLD=5

# Minimum allowed schedule interval in milliseconds.
CODEXCLAW_SCHEDULER_MIN_INTERVAL_MS=60000

# Enable the optional Markdown Knowledge Wiki.
CODEXCLAW_WIKI_ENABLED=false

# Root directory for generated wiki pages, manifests, and lint reports. Relative paths resolve from the workspace.
CODEXCLAW_WIKI_ROOT=wiki

# Comma-separated roots that /wiki ingest may read from. Relative paths resolve from the workspace.
CODEXCLAW_WIKI_ALLOWED_SOURCE_ROOTS=.

# Maximum size in bytes for one selected source file.
CODEXCLAW_WIKI_MAX_SOURCE_BYTES=131072

# Maximum number of query results returned by /wiki query.
CODEXCLAW_WIKI_MAX_QUERY_RESULTS=5

# Maximum characters per wiki query excerpt/context snippet.
CODEXCLAW_WIKI_MAX_EXCERPT_CHARS=500
